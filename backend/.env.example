OPENROUTER_API_KEY=your_openrouter_key_here

# Must match the JWT_SECRET used by the frontend (frontend/) to sign auth tokens
JWT_SECRET=your_shared_jwt_secret_here

# Comma-separated list of allowed CORS origins, e.g. https://app.example.com,https://admin.example.com
# Defaults to http://localhost:3100 if unset
ALLOWED_ORIGINS=http://localhost:3100
